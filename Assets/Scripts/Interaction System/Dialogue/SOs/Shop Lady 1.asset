  DialogueLines:
  - lines: []
  - lines:
    - '"Marcher. Welcome to land of ruins."'
  - lines:
    - '"Best leave the unknown untouched"'
    - "\"The truth bites. And this place still bleeds from it. You\u2019ll need more
      than muscle to survive. Want something clever? Trade up.\""
